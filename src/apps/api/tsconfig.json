{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Overrides para ignorar erros */
    "strict": false,
    "strictNullChecks": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitAny": false,
    "noEmitOnError": false,
    "skipLibCheck": true,

    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}