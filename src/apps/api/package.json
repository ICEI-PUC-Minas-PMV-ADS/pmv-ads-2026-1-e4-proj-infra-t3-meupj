{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,mjs,ts}\" \"bruno/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,mjs,ts}\" \"bruno/**/*.yml\""
  },
  "dependencies": {
    "@better-auth/expo": "1.6.13",
    "@fastify/cors": "11.2.0",
    "@fastify/env": "5.0.3",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@react-pdf/renderer": "4.5.1",
    "@sinclair/typebox": "0.34.48",
    "better-auth": "1.6.13",
    "env-schema": "7.0.0",
    "fastify": "5.8.2",
    "mongodb": "7.1.0",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "25.5.0",
    "eslint": "10.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
