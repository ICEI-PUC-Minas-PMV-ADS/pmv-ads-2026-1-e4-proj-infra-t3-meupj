            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('status confirmado', function () {",
                  "  pm.expect(body.status).to.eql('confirmed');",
                  "});"
                ]
              }
            }
          ]
        },
