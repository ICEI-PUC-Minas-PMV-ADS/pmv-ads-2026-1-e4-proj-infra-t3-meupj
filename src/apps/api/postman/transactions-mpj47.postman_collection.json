          ]
        },
        {
          "name": "Delete Income (must pass 204)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{incomeTransactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
